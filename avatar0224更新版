{% load static %}
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>アバター編集 | Daily Goal</title>
    <link rel="stylesheet" href="{% static 'style.css' %}">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --accent-color: #3b82f6;
            --bg-color: #f0f2f5;
            --danger-color: #ef4444;
            --gold-color: #f59e0b;
        }

        body { margin: 0; font-family: 'Helvetica Neue', Arial, sans-serif; background: var(--bg-color); color: #333; overflow: hidden; }
        
        /* ヘッダー：ミッション画面と統一 */
        .header-nav { 
            background: #fff; padding: 10px 20px; border-bottom: 1px solid #ddd; 
            display: flex; align-items: center; gap: 12px; z-index: 100; position: sticky; top: 0;
        }
        .header-nav button { 
            padding: 8px 15px; cursor: pointer; border: 1px solid #ddd; 
            background: #fff; border-radius: 6px; font-weight: bold; 
        }
        .btn-active { background: var(--accent-color) !important; color: white !important; border-color: var(--accent-color) !important; }
        .logo-link { text-decoration: none; display: flex; align-items: center; gap: 8px; margin-right: 10px; transition: opacity 0.2s; }
        .logo-link:hover { opacity: 0.8; }
        .logo-img { height: 32px; width: auto; }
        .logo-text { font-weight: bold; color: var(--accent-color); font-size: 18px; }
        
        .logout-form { margin-left: auto; }
        .btn-logout { color: var(--danger-color) !important; border: 1px solid #fee2e2 !important; }

        /* コンテナ：中央配置 */
        .shop-container { 
            display: flex; max-width: 1300px; margin: 20px auto; 
            background: #fff; border-radius: 24px; overflow: hidden; 
            box-shadow: 0 15px 35px rgba(0,0,0,0.1); height: calc(100vh - 120px); 
        }

        /* プレビューエリア */
        .preview-pane { flex: 1.5; background: #f8fafc; position: relative; display: flex; justify-content: center; align-items: center; overflow: hidden; }
        .view-mode-tabs { position: absolute; top: 20px; left: 20px; z-index: 20; display: flex; gap: 10px; }
        .avatar-viewport { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; }
        .preview-img { max-width: 90%; max-height: 90%; object-fit: contain; pointer-events: none; transition: opacity 0.2s; }

        /* 操作パネル */
        .control-pane { width: 450px; border-left: 1px solid #eee; display: flex; flex-direction: column; background: #fff; }
        .user-header { padding: 30px 20px; border-bottom: 2px solid #f0f4f8; display: flex; flex-direction: column; align-items: center; gap: 10px; }
        
        /* アバター表示：ミッション画面のスタイルを大きくしたもの */
        .user-icon-huge { width: 180px; height: 180px; position: relative; display: flex; justify-content: center; align-items: center; }
        #face-wrapper { 
            width: 100%; height: 100%; border-radius: 50%; background: #fff; overflow: hidden; 
            border: 6px solid {% if avatar.frame_type and avatar.frame_type != '0' %}transparent{% else %}#3b82f6{% endif %}; 
            position: relative; z-index: 5; transition: border-color 0.3s; box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }
        #mini-face { width: 100%; height: 100%; object-fit: cover; }
        #mini-frame { position: absolute; z-index: 10; width: 148%; height: auto; top: 80%; left: 68%; transform: translate(-50%, -50%); object-fit: contain; pointer-events: none; }

        .user-info-box { text-align: center; }
        .username-text { font-size: 20px; font-weight: bold; color: #1e293b; }
        .coin-display { color: var(--gold-color); font-weight: bold; margin-top: 4px; display: flex; align-items: center; justify-content: center; gap: 5px; font-size: 18px; }
        .current-title-badge { background: var(--accent-color); color: white; padding: 4px 12px; border-radius: 6px; font-size: 12px; font-weight: bold; margin-bottom: 5px; display: inline-block; }

        /* タブ */
        .tab-group { display: flex; background: #f8fafc; border-bottom: 1px solid #eee; }
        .tab-item { flex: 1; padding: 12px 5px; text-align: center; cursor: pointer; font-weight: bold; color: #64748b; border-bottom: 4px solid transparent; font-size: 14px; }
        .tab-item.active { color: var(--accent-color); border-bottom-color: var(--accent-color); background: #fff; }

        /* リスト */
        .item-list-container { flex: 1; padding: 20px; overflow-y: auto; }
        .grid-layout { display: none; grid-template-columns: repeat(4, 1fr); gap: 10px; }
        .grid-layout.active { display: grid; }
        
        .item-card { border: 2px solid #f1f5f9; border-radius: 12px; cursor: pointer; background: #fff; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; flex-direction: column; position: relative; font-size: 11px; transition: 0.2s; padding: 5px; }
        .item-card:hover { border-color: #cbd5e1; }
        .item-card.selected { border-color: var(--accent-color); background: #eff6ff; color: var(--accent-color); }
        .item-thumb { width: 85%; height: 85%; object-fit: contain; }
        .title-card { height: auto; aspect-ratio: auto; padding: 15px 10px; }

        /* 保存ボタン：ミッション画面の「挑戦」ボタンの色味に統一 */
        .footer-save { padding: 20px; border-top: 1px solid #eee; }
        .save-button { 
            width: 100%; padding: 16px; background: var(--accent-color); color: white; 
            border: none; border-radius: 12px; font-size: 18px; font-weight: bold; cursor: pointer; 
            box-shadow: 0 4px 0 #1d4ed8; transition: 0.2s;
        }
        .save-button:active { transform: translateY(2px); box-shadow: 0 2px 0 #1d4ed8; }

        .mode-btn { padding: 10px 15px; border-radius: 10px; border: 1px solid var(--accent-color); background: #fff; color: var(--accent-color); cursor: pointer; font-weight: bold; font-size: 13px; }
        .mode-btn.active { background: var(--accent-color); color: #fff; }
    </style>
</head>
<body>

    <header class="header-nav">
        <a href="{% url 'calendar_view' %}" class="logo-link">
            <img src="{% static 'users/logo.png' %}" alt="Daily Goal" class="logo-img">
            <span class="logo-text">Daily Goal</span>
        </a>
        <button onclick="location.href='{% url 'calendar_view' %}'">カレンダー</button>
        <button onclick="location.href='{% url 'mission_list' %}'">ミッション</button>
        <button class="btn-active" onclick="location.href='{% url 'avatar_edit' %}'">アバター</button>
        <button onclick="location.href='{% url 'avatar_shop' %}'">ショップ</button>
        
        <form action="{% url 'logout' %}" method="post" class="logout-form">
            {% csrf_token %}
            <button type="submit" class="btn-logout">ログアウト</button>
        </form>
    </header>

    <div class="shop-container">
        <div class="preview-pane">
            <div class="view-mode-tabs">
                <button id="btn-full" class="mode-btn active" onclick="setViewMode('full')">全体像</button>
                <button id="btn-face-up" class="mode-btn" onclick="setViewMode('face-up')">顔アップ</button>
            </div>
            <div id="avatar-viewport" class="avatar-viewport">
                <img id="display-img" 
                     src="{% if avatar.back_type and avatar.back_type != '0' %}/static/images/avatar/back_{{ avatar.back_type }}.png{% endif %}" 
                     class="preview-img" 
                     style="display: {% if avatar.back_type and avatar.back_type != '0' %}block{% else %}none{% endif %};">
            </div>
        </div>

        <div class="control-pane">
            <div class="user-header">
                <div class="user-icon-huge">
                    <div id="face-wrapper">
                        {% if avatar.face_type and avatar.face_type != "0" %}
                            <img id="mini-face" src="/static/images/avatar/face_{{ avatar.face_type }}.png">
                        {% else %}
                            <div id="mini-empty" style="display:flex; width:100%; height:100%; background:#e2e8f0; align-items:center; justify-content:center;">
                                <i class="fas fa-user" style="color:#94a3b8; font-size:40px;"></i>
                            </div>
                            <img id="mini-face" src="" style="display:none; width: 100%; height: 100%; object-fit: cover;">
                        {% endif %}
                    </div>
                    <img id="mini-frame" src="{% if avatar.frame_type %}/static/images/avatar/frame_{{ avatar.frame_type }}.png{% endif %}" 
                         style="display:{% if avatar.frame_type and avatar.frame_type != '0' %}block{% else %}none{% endif %};">
                </div>
                
                <div class="user-info-box">
                    <div class="username-text">{{ user.username }} さん</div>
                    <div class="current-title-badge" id="display-current-title">{{ avatar.current_title|default:"新米" }}</div>
                    <div class="coin-display">
                        <i class="fas fa-coins"></i> {{ avatar.points }}
                    </div>
                </div>
            </div>

            <div class="tab-group">
                <div id="tab-back" class="tab-item active" onclick="switchTab('back')">ベース</div>
                <div id="tab-face" class="tab-item" onclick="switchTab('face')">表情</div>
                <div id="tab-frame" class="tab-item" onclick="switchTab('frame')">フレーム</div>
                <div id="tab-title" class="tab-item" onclick="switchTab('title')">称号</div>
            </div>

            <div class="item-list-container">
                <div id="grid-back" class="grid-layout active">
                    <div class="item-card {% if not avatar.back_type or avatar.back_type == '0' %}selected{% endif %}" onclick="updateItem('back', '0')">
                        <i class="fas fa-user-slash fa-2x"></i>
                        <p>なし</p>
                    </div>
                    {% for item in avatar.owned_items.all %}
                        {% if item.category == 'back' %}
                        <div class="item-card {% if avatar.back_type == item.image_id %}selected{% endif %}" onclick="updateItem('back', '{{ item.image_id }}')">
                            <img src="/static/images/avatar/back_{{ item.image_id }}.png" class="item-thumb">
                            <p style="margin: 0; font-size: 10px;">{{ item.name }}</p>
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>

                <div id="grid-face" class="grid-layout">
                    <div class="item-card {% if not avatar.face_type or avatar.face_type == '0' %}selected{% endif %}" onclick="updateItem('face', '0')">
                        <i class="fas fa-minus fa-2x"></i>
                        <p>なし</p>
                    </div>
                    {% for item in avatar.owned_items.all %}
                        {% if item.category == 'face' %}
                        <div class="item-card {% if avatar.face_type == item.image_id %}selected{% endif %}" onclick="updateItem('face', '{{ item.image_id }}')">
                            <img src="/static/images/avatar/face_{{ item.image_id }}.png" class="item-thumb">
                            <p style="margin: 0; font-size: 10px;">{{ item.name }}</p>
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>

                <div id="grid-frame" class="grid-layout">
                    <div class="item-card {% if not avatar.frame_type or avatar.frame_type == '0' %}selected{% endif %}" onclick="updateItem('frame', '0')">
                        <i class="fas fa-ban fa-2x"></i><p>なし</p>
                    </div>
                    {% for item in avatar.owned_items.all %}
                        {% if item.category == 'frame' %}
                        <div class="item-card {% if avatar.frame_type == item.image_id %}selected{% endif %}" onclick="updateItem('frame', '{{ item.image_id }}')">
                            <img src="/static/images/avatar/frame_{{ item.image_id }}.png" class="item-thumb">
                            <p style="margin: 0; font-size: 10px;">{{ item.name }}</p>
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>

                <div id="grid-title" class="grid-layout">
                    <div class="item-card title-card {% if avatar.current_title == '新米' %}selected{% endif %}" onclick="updateTitle('新米')">
                        <i class="fas fa-seedling fa-2x"></i>
                        <p>新米</p>
                    </div>
                    {% for prog in user.usermissionprogress_set.all %}
                        {% if prog.is_reward_received and prog.mission.title_reward %}
                        <div class="item-card title-card {% if avatar.current_title == prog.mission.title_reward %}selected{% endif %}" onclick="updateTitle('{{ prog.mission.title_reward }}')">
                            <i class="fas fa-award fa-2x" style="color: var(--gold-color);"></i>
                            <p>{{ prog.mission.title_reward }}</p>
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            <div class="footer-save">
                <form method="POST">
                    {% csrf_token %}
                    <input type="hidden" name="back_type" id="input-back" value="{{ avatar.back_type|default:'0' }}">
                    <input type="hidden" name="face_type" id="input-face" value="{{ avatar.face_type|default:'0' }}">
                    <input type="hidden" name="frame_type" id="input-frame" value="{{ avatar.frame_type|default:'0' }}">
                    <input type="hidden" name="current_title" id="input-title" value="{{ avatar.current_title|default:'新米' }}">
                    <button type="submit" class="save-button">スタイルを保存する</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        let isFaceUpMode = false;

        function updateTitle(titleName) {
            document.getElementById('input-title').value = titleName;
            document.getElementById('display-current-title').innerText = titleName;
            const container = document.getElementById('grid-title');
            container.querySelectorAll('.item-card').forEach(c => c.classList.remove('selected'));
            event.currentTarget.classList.add('selected');
        }

        function updateItem(type, id) {
            const displayImg = document.getElementById('display-img');
            const miniFace = document.getElementById('mini-face');
            const miniEmpty = document.getElementById('mini-empty');
            const miniFrame = document.getElementById('mini-frame');
            const faceWrapper = document.getElementById('face-wrapper');

            document.getElementById('input-' + type).value = id;

            if (type === 'back') {
                if (!isFaceUpMode) {
                    if (id === '0') {
                        displayImg.style.display = 'none';
                        displayImg.src = "";
                    } else {
                        displayImg.style.display = 'block';
                        displayImg.src = "/static/images/avatar/back_" + id + ".png";
                    }
                }
            } else if (type === 'face') {
                const path = "/static/images/avatar/face_" + id + ".png";
                if (id === '0') {
                    if(miniFace) miniFace.style.display = 'none';
                    if(miniEmpty) miniEmpty.style.display = 'flex';
                    if(isFaceUpMode) displayImg.src = ""; 
                } else {
                    if(miniFace) {
                        miniFace.src = path;
                        miniFace.style.display = 'block';
                    }
                    if(miniEmpty) miniEmpty.style.display = 'none';
                    if(isFaceUpMode) displayImg.src = path;
                }
            } else if (type === 'frame') {
                if (id === '0') {
                    if(miniFrame) miniFrame.style.display = 'none';
                    if(faceWrapper) faceWrapper.style.borderColor = "#3b82f6";
                } else {
                    if(miniFrame) {
                        miniFrame.src = "/static/images/avatar/frame_" + id + ".png";
                        miniFrame.style.display = 'block';
                    }
                    if(faceWrapper) faceWrapper.style.borderColor = "transparent";
                }
            }

            const card = event.currentTarget;
            const container = card.parentElement;
            container.querySelectorAll('.item-card').forEach(c => c.classList.remove('selected'));
            card.classList.add('selected');
        }

        function setViewMode(mode) {
            isFaceUpMode = (mode === 'face-up');
            const displayImg = document.getElementById('display-img');
            const faceId = document.getElementById('input-face').value;
            const backId = document.getElementById('input-back').value;
            
            if (isFaceUpMode) {
                displayImg.src = faceId !== '0' ? "/static/images/avatar/face_" + faceId + ".png" : "";
                displayImg.style.display = (faceId !== '0') ? 'block' : 'none';
                document.getElementById('btn-face-up').classList.add('active');
                document.getElementById('btn-full').classList.remove('active');
            } else {
                if (backId === '0') {
                    displayImg.style.display = 'none';
                    displayImg.src = "";
                } else {
                    displayImg.style.display = 'block';
                    displayImg.src = "/static/images/avatar/back_" + backId + ".png";
                }
                document.getElementById('btn-full').classList.add('active');
                document.getElementById('btn-face-up').classList.remove('active');
            }
        }

        function switchTab(type) {
            document.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.grid-layout').forEach(g => g.classList.remove('active'));
            document.getElementById('tab-' + type).classList.add('active');
            document.getElementById('grid-' + type).classList.add('active');
            if (type === 'face') setViewMode('face-up');
            else if (type === 'back') setViewMode('full');
        }
    </script>
</body>
</html>
